// 敵の強さの伸び方。20階までは g1 の累乗、21階以降は「階ごとの伸び g2 と、20階ごとの段階ジャンプ jump」を CFG.endlessSpeed 乗する
const growAt=(i,g1,g2,jump)=>i<FLOORS?Math.pow(g1,i):Math.pow(g1,FLOORS-1)*Math.pow(Math.pow(g2,i-FLOORS+1)*Math.pow(jump,tierOf(i)),CFG.endlessSpeed);
const enemyHp=(i,t)=>Math.round(CFG.hp0*growAt(i,CFG.hpGrow,CFG.hpGrow2,CFG.hpJump)*(t.hm||1));
const enemyAtk=(i,t)=>Math.max(1,Math.round(CFG.atk0*growAt(i,CFG.atkGrow,CFG.atkGrow2,CFG.atkJump)*(t.am||1)));

/* ===== ダイスの集計 =====
   ダイスの種類そのもの（名前・目・価格・説明）は data/equipment.xlsx の「ダイス」シートで編集する。
   ここには、出目の集計（スキルや装備が見る P の中身）と、特殊ダイスの効果計算が入っている。 */
const R6=[1,2,3,4,5,6];
/* ===== ダイスの集計（スキルはこれを見て威力が決まる） ===== */
const matchBonus=(M,jack)=>{const b=M<=1?1:M===2?1.3:M===3?1.6:M===4?2:2+0.5*(M-4);return jack?Math.max(b*1.5,3):b};   // 揃いボーナスに上限なし（5個以上は1個ごとに+0.5）
function pool(){
  const cnt={};let S=0,sumHigh=0,sumOdd=0,odd=0,high=0,even=0;
  for(const d of p.dice){
    cnt[d.v]=(cnt[d.v]||0)+1;
    const w=d.v*(d.t==='fire'?2:d.t==='ice'&&d.v<=3?2:d.t==='thunder'&&d.v%2===0?2:d.t==='poison'&&d.v%2===1?2:1);
    S+=w;
    if(d.v>=4){sumHigh+=w;high++}
    if(d.v%2===1){sumOdd+=w;odd++}else even++;
  }
  const faces=Object.keys(cnt).map(Number).sort((a,b)=>a-b);
  let M=0;faces.forEach(f=>{M=Math.max(M,cnt[f])});
  const N=p.dice.length,jack=N>=3&&faces.length===1;
  let run=0,best=0,prev=null;
  faces.forEach(f=>{run=(prev!==null&&f===prev+1)?run+1:1;best=Math.max(best,run);prev=f});
  const pairs=faces.filter(f=>cnt[f]>=2).length;
  const eqs=p.equip?equipped():[];
  const sm=eqs.reduce((m,it)=>m*(it.sumMul||1),1);
  let mult=matchBonus(M,jack);
  if(eqs.some(it=>it.matchPow))mult=+(mult*mult).toFixed(2);
  return {cnt,S:R(S*sm),N,M,mult,jack,run:best,pairs,high,sumHigh:R(sumHigh*sm),odd,sumOdd:R(sumOdd*sm),even};
}
const tallyText=()=>{const P=pool();return Object.keys(P.cnt).map(Number).sort((a,b)=>a-b).map(f=>`${f}×${P.cnt[f]}`).join(' ')};

/* ===== 目の役割 =====
   サイコロの目（1〜6）には、それぞれ役割がある。最終的に出ている目の「個数」が多いほど、その役割が強くなる。
   役割の名前・アイコン・説明・効果の大きさは data/equipment.xlsx の「目の役割」シートで編集する（シートがなければ下の初期値）。
   キープできる目は1種類だけなので、「どの目を伸ばすか」が、そのまま「どの役割を伸ばすか」になる。
     1 速さ …… 1の目の個数が、行動の速さになる。さらに振り直し回数・行動回数も増える（効果量1＝何個ごとに振り直し+1／効果量2＝何個ごとに行動回数+1／効果量3＝1の目1個あたりの行動の速さ）
     2 耐久 …… 受けるダメージが減る（効果量1＝1個あたりの軽減の強さ。被ダメージ＝1÷(1＋2の個数×効果量1)。「行動を実行」を押した時点の出目で決まる）
     3 会心 …… 攻撃が会心（大ダメージ）になりやすい（効果量1＝1個あたりの会心率／効果量2＝会心時のダメージ倍率。行動を予約した時点の出目で決まる）
     4 魔力 …… 魔法の目。魔法スキルは、すべて4の目が条件。行動の実行前にMP回復、魔法のダメージ増（効果量1＝1個あたりのMP／効果量2＝1個あたりの魔法ダメージ増）
     5 技巧 …… 状態異常が強くなる（効果量1＝1個あたりの強さ増。毒・火傷・出血のダメージ、弱体の軽減、弱点看破の倍率）。装備の付与確率も上がる（効果量2＝1個あたりの確率増）。毒・火傷・出血の継続ターンが延びる（効果量3＝何個ごとに+1ターン）
     6 攻撃 …… 与えるダメージが増える（効果量1＝1個あたりのダメージ増） */
const ROLE_DEFAULT={
  1:{name:'速さ',icon:'⚡',desc:'1の目の個数が、行動の速さになる。さらに、振り直しと行動回数も増える。',a:3,b:6,c:1},
  2:{name:'耐久',icon:'🛡',desc:'2の目の個数に応じて、受けるダメージが減る。',a:0.06,b:0},
  3:{name:'会心',icon:'💥',desc:'3の目の個数に応じて、攻撃が会心（大ダメージ）になりやすい。',a:0.04,b:2},
  4:{name:'魔力',icon:'🔮',desc:'魔法の目。行動の実行前にMPが回復し、魔法のダメージが増える。魔法スキルは、すべて4の目が条件。',a:0.5,b:0.06},
  5:{name:'技巧',icon:'🎯',desc:'状態異常（毒・火傷・出血・弱体・弱点看破）が強くなり、毒・火傷・出血は続く期間（ターン／回数）も延びる。装備の付与確率も上がる。',a:0.06,b:0.02,c:3},
  6:{name:'攻撃',icon:'⚔️',desc:'6の目の個数に応じて、与えるダメージが増える。',a:0.05,b:0},
};
let ROLE=ROLE_DEFAULT;
const roleCnt=(P,f)=>(P&&P.cnt&&P.cnt[f])||0;
const roleUse=(f)=>ROLE[f]||null;

function roleRerollBonus(P){const r=roleUse(1);return r&&r.a>0?Math.floor(roleCnt(P,1)/r.a):0}
function roleSpeedBonus(P){const r=roleUse(1);return r&&r.c>0?Math.floor(roleCnt(P,1)*r.c):0}   // 1の目の個数×効果量3＝行動の速さ
function roleActionBonus(P){const r=roleUse(1);return r&&r.b>0?Math.floor(roleCnt(P,1)/r.b):0}
function roleTakeMul(P){const r=roleUse(2);return r&&r.a>0?1/(1+roleCnt(P,2)*r.a):1}   // 耐久（2）：被ダメージの倍率
function roleCritChance(P){const r=roleUse(3);return r&&r.a>0?Math.min(0.9,roleCnt(P,3)*r.a):0}   // 会心（3）：会心率
const roleCritMul=()=>{const r=roleUse(3);return r&&r.b>1?r.b:2};
function roleMana(P){const r=roleUse(4),c=roleCnt(P,4);return r&&r.a>0?Math.floor(c*r.a):0}
function roleMagMul(P){const r=roleUse(4);return r&&r.b>0?1+roleCnt(P,4)*r.b:1}
function roleStatusMul(P){const r=roleUse(5);return r&&r.a>0?1+roleCnt(P,5)*r.a:1}
function roleStatusDuration(P){const r=roleUse(5);return r&&r.c>0?Math.floor(roleCnt(P,5)/r.c):0}   // 毒・火傷・出血の継続ターン+
function roleWeakMul(P){const r=roleUse(5);return r&&r.a>0?0.5/(1+roleCnt(P,5)*r.a):0.5}   // 弱体：敵の次の攻撃の倍率（基本0.5）
function roleVulnMul(P){const r=roleUse(5);return r&&r.a>0?1.5+roleCnt(P,5)*r.a*0.5:1.5}   // 弱点看破：次に受けるダメージの倍率（基本1.5）
function roleChanceBonus(P){const r=roleUse(5);return r&&r.b>0?roleCnt(P,5)*r.b:0}
function roleAtkMul(P){const r=roleUse(6);return r&&r.a>0?1+roleCnt(P,6)*r.a:1}

// いまの出目で働いている役割の一覧（画面に出す）
function roleSummary(P){
  const out=[],t=(f,s)=>out.push(`${ROLE[f].icon}${ROLE[f].name} ${s}`);
  if(roleUse(1)){const a=roleRerollBonus(P),b=roleActionBonus(P),c=roleSpeedBonus(P);if(a||b||c)t(1,[a?`振り直し+${a}`:'',b?`行動+${b}`:'',c?`速さ+${c}`:''].filter(Boolean).join('・'))}
  if(roleUse(2)){const m=roleTakeMul(P);if(m<1)t(2,`被ダメージ×${fmtM(+m.toFixed(2))}`)}
  if(roleUse(3)){const c=roleCritChance(P);if(c>0)t(3,`会心${Math.round(c*100)}%（×${fmtM(roleCritMul())}）`)}
  if(roleUse(4)){const m=roleMana(P),g=roleMagMul(P);if(m>0||g>1)t(4,[m?`MP+${m}`:'',g>1?`魔法×${fmtM(g)}`:''].filter(Boolean).join('・'))}
  if(roleUse(5)){const m=roleStatusMul(P),d=roleStatusDuration(P),c=roleChanceBonus(P),v=roleVulnMul(P);const parts=[m>1?`状態異常×${fmtM(m)}`:'',d>0?`継続+${d}`:'',c>0?`付与率+${Math.round(c*100)}%`:'',v>1.5?`弱点×${fmtM(+v.toFixed(2))}`:''].filter(Boolean);if(parts.length)t(5,parts.join('・'))}
  if(roleUse(6)){const a=roleAtkMul(P);if(a>1)t(6,`ダメージ×${fmtM(a)}`)}
  return out;
}

/* ===== 速さと行動順 =====
   1ターンの流れ：サイコロを振る（振り直し） → 行動ボタンを押して「予約」する（最大 p.actions 個）→ 「行動を実行」。
   ・行動を予約した瞬間の出目が、その行動の能力になる（速さも、ダメージなどの威力も）。
     予約したあとで振り直しても、予約済みの行動は、予約した時の出目のまま。
   ・行動の速さ ＝ 1の目の個数 × 目の役割の効果量3（初期値1） ＋ 装備の「行動の速さ+」。
   ・実行は、味方の予約した行動と敵の1回の行動を「速さの大きい順」に並べて行う（同じ速さなら味方が先、味方同士は予約した順）。
   ・敵の速さ ＝ 敵の種類ごとの基本値（enemies.js の spd）＋ 階数÷CFG.enemySpeedStep（切り捨て）。 */
const enemySpeed=(i,t)=>(t.spd===undefined?1:t.spd)+Math.floor(i/CFG.enemySpeedStep);
const actionSpeed=P=>roleSpeedBonus(P)+equipped().reduce((n,it)=>n+(it.speedBonus||0),0);

// 予約した行動＋敵 を、速さの順に並べる
function planTimeline(){
  const ev=p.queue.map((q,i)=>({who:'p',q,id:q.id,spd:q.spd,slot:i}));
  ev.push({who:'e',spd:e.spd,slot:99});
  ev.sort((a,b)=>(b.spd-a.spd)||(a.who===b.who?a.slot-b.slot:(a.who==='p'?-1:1)));
  return ev;
}
const mpCost=a=>Math.max(0,(a.mp||0)-equipped().reduce((n,it)=>n+(it.mpDiscount||0),0));
const reservedMp=()=>p.queue.reduce((n,q)=>n+mpCost(ALL[q.id]),0);

function timelineHTML(){
  const free=Math.max(0,p.actions-p.queue.length);
  const chips=planTimeline().map(x=>{
    if(x.who==='e')return `<span class="tlc en">👹 ${escHtml(e.name)} 速さ<b>${x.spd}</b></span>`;
    const a=ALL[x.id],r=a.calc(x.q.P);
    const dm=r.dmg?` 約${fmt(previewFinal(r.dmg,x.q.P,a))}`:'';
    return `<button class="tlc q" data-q="${x.slot}" title="タップで予約を取り消す">${escHtml(a.name)} 速さ<b>${x.spd}</b>${dm}</button>`;
  }).join('<i class="tla">›</i>');
  return `<div class="grp">行動の順番（速さの大きい順・あと${free}回予約できる）</div><div class="tl">${chips}</div>`+
    (p.queue.length?'':'<div class="sub tlhint">行動ボタンを押すと、いまの出目で予約されます。予約したあとで振り直しても、予約は変わりません。</div>');
}

// --- 予約 ---
function syncQueue(){p.actionsUsed=p.queue.length;syncRoleBonuses()}
function queueAction(a){
  if(p.queue.length>=p.actions)return;
  const P=pool();   // いまの出目を、この行動の能力として記録する
  p.queue.push({id:a.id,P,spd:actionSpeed(P)});p.used[a.id]=true;syncQueue();render();
}
function unqueue(slot){
  const q=p.queue[slot];if(!q)return;
  p.queue.splice(slot,1);p.used[q.id]=false;syncQueue();render();
}
function clearQueue(){
  for(const q of p.queue)p.used[q.id]=false;
  p.queue=[];p.actionsUsed=0;
}

// --- 実行 ---
async function doAction(q,no,total){
  const a=ALL[q.id],P=q.P,r=a.calc(P),cost=mpCost(a);
  if(!r.ok||p.mp<cost){
    const why=!r.ok?(r.needText||a.need||'条件を満たさない'):'MPが足りない';
    rec(`【行動${no}/${total}】${a.name}は不発（${why}）`,'act');log(`${a.name}は不発！（${why}）`);render();await sleep(380);return;
  }
  p.mp-=cost;
  if(a.cd){const w=Math.max(0,a.cd-(has('haste')?1:0)-equipped().reduce((n,it)=>n+(it.cooldownReduce||0),0));if(w>0){p.cds[a.id]=w;p.cdFresh[a.id]=true;rec(`　${a.name}は${w}ターン使えなくなる`,'act')}}
  p.currentSkill=a.id;
  rec(`【行動${no}/${total}】${a.name}（速さ${q.spd}）${a.mp?`（MP${a.mp}消費）`:''}`,'act');
  rec(`　予約した時の出目：合計${fmt(P.S)}／最多${P.M}個／揃い×${fmtM(P.mult)}／ペア${P.pairs}組`,'act');
  log(`${a.name}！`,true);render();await sleep(220);
  await apply(r,P);
}
// 敵の番：状態異常のダメージ → 敵の行動
async function enemyTurn(){
  for(const [key,label] of [['poison','毒'],['burn','火傷']]){   // 出血は、時間ではなく「ダメージを受けるたび」に入る（main.js の bleedTrigger）
    const st=e[key];if(!st)continue;const d=key==='poison'?Math.max(1,R(e.maxHp*st.pct)):st.d;e.hp=Math.max(0,e.hp-d);st.t--;if(st.t<=0)e[key]=null;
    rec(`【${label}】${e.name}に${label}ダメージ${d}`,'take');log(`${label}で${e.name}に${d}のダメージ！`,true);popup('scene',d,'dmg');render();await sleep(350);
    if(e.hp<=0)return;
  }
  await enemyAct();
}
async function runTimeline(){
  busy=true;
  const ev=planTimeline(),total=ev.filter(x=>x.who==='p').length;
  p.actionsLeft=0;p.execP=pool();render();await sleep(250);   // 耐久(2)・魔力(4)の目は、実行を押した時点の出目で決まる
  await roleTurnEnd();
  rec(`【行動順】${ev.map(x=>x.who==='e'?`敵(${x.spd})`:`${ALL[x.id].name}(${x.spd})`).join(' → ')}`,'act');
  let n=0;
  for(const x of ev){
    if(x.who==='p'){
      n++;await doAction(x.q,n,total);
      p.currentSkill=null;
      if(e.hp<=0){endTurnCd();await win();return}
    }else{
      await enemyTurn();
      if(p.hp<=0){await lose();return}
      if(e.hp<=0){endTurnCd();await win();return}
    }
  }
  if(has('regen')&&p.hp<p.maxHp){const h=Math.max(1,R(p.maxHp*.03));p.hp=Math.min(p.maxHp,p.hp+h);popup('pl','+'+h,'heal')}
  p.shield=0;
  endTurnCd();
  await startTurn();
  busy=false;render();
}

/* ===== 装備のしくみ =====
   装備の名前・価格・説明・数値は data/equipment.xlsx、効果のプログラムは js/equipment_fx.js。
   ここには、枠・装着・発動順・ダメージ計算の流れ（装備が上から順に発動する処理）が入っている。 */
/* ===== 装備：出目に反応して、上から順に発動する ===== */
const SLOT_NAME={weapon:'武器',armor:'防具',acc:'アクセ'};
const SLOT_ORDER=['weapon','armor','acc'];
const SLOT_TYPE={weapon:'武器',armor:'防具',acc:'アクセ'};
const baseSlots=()=>[{t:'weapon',id:null},{t:'armor',id:null},{t:'acc',id:null},{t:'acc',id:null}];
const equipped=()=>p.equip.filter(x=>x.id).map(x=>ITEM_BY[x.id]);
const ownedItem=id=>p.equip.some(x=>x.id===id);
function growSlots(){
  for(const t of SLOT_ORDER)p.equip.push({t,id:null});   // 増えた枠は一番下に追加（並び替えは自由）
}
function moveSlot(code){
  const [i,dir]=String(code).split(':');const k=+i,j=dir==='up'?k-1:k+1;
  if(!(k>=0&&k<p.equip.length)||j<0||j>=p.equip.length)return false;
  const a=p.equip[k],b=p.equip[j];
  p.equip[k]=b;p.equip[j]=a;
  rec(`【装備の並び替え】${a.id?ITEM_BY[a.id].name:'空き枠'}を${dir==='up'?'上':'下'}へ移動`,'s');
  return true;
}
const itemOpt=it=>({id:'i_'+it.id,name:it.name,tag:`装備・${SLOT_TYPE[it.slot]}${it.leg?'・伝説':it.rare?'・レア':''}`,desc:it.desc,cls:it.leg?'legend':'',apply:()=>equipItem(it,false)});
const takeMul=()=>equipped().reduce((m,it)=>m*(it.take?it.take():1),1);

function runPipeline(base,P,preview,sk){
  let v=base;const steps=[];
  const skillId=p.currentSkill||'';
  const skillBoost=equipped().reduce((m,it)=>m*((it.skillMul&&it.skillMul[skillId])||1),1);
  if(skillBoost!==1){v=cl(v*skillBoost);steps.push({id:null,name:'スキル強化',msg:skillId,t:`×${skillBoost}`,v:R(v)})}
  for(const it of equipped()){
    if(!it.dmg)continue;
    const r=it.dmg(P);if(!r)continue;
    let t='';
    if(r.add){v=cl(v+r.add);t=`+${fmt(R(r.add))}`}
    if(r.mul){v=cl(v*r.mul);t=`×${fmtM(r.mul)}`}
    if(r.rand){
      const m=preview?(r.rand[0]+r.rand[1])/2:+(r.rand[0]+Math.random()*(r.rand[1]-r.rand[0])).toFixed(1);
      v=cl(v*m);t=`×${m}`;
    }
    steps.push({id:it.id,name:it.name,msg:r.msg,t,v:R(v)});
  }
  const rm=roleAtkMul(P)*(((sk||ALL[skillId])||{}).type==='mag'?roleMagMul(P):1);   // 目の役割：攻撃（6）・魔力（4）
  if(rm!==1){v=cl(v*rm);steps.push({id:null,name:'目の役割',msg:`${roleCnt(P,6)?`${ROLE[6].icon}${roleCnt(P,6)}個`:''}${roleMagMul(P)>1&&((sk||ALL[skillId])||{}).type==='mag'?` ${ROLE[4].icon}${roleCnt(P,4)}個`:''}`.trim(),t:`×${fmtM(rm)}`,v:R(v)})}
  if(has('power')){v=cl(v*1.2);steps.push({id:null,name:'闘志',msg:'',t:'×1.2',v:R(v)})}
  if(p.dbl){v=cl(v*2);steps.push({id:null,name:'ダブルアップ',msg:'',t:'×2',v:R(v)})}
  return {base:R(base),steps,final:Math.max(1,R(cl(v)))};
}
const previewFinal=(base,P,sk)=>runPipeline(base,P,true,sk).final;
function guardFinal(base,P){
  let v=base;const steps=[];
  for(const it of equipped()){
    if(!it.sh)continue;
    const r=it.sh(P);if(!r)continue;
    v=cl(v+r.add);steps.push({id:it.id,name:it.name,msg:r.msg,t:`+${fmt(R(r.add))}`,v:R(v)});
  }
  return {base:R(base),steps,final:Math.max(1,R(v))};
}
async function cascade(res,note){
  const c=$('#casc'),bs=$('#bigscore');
  rec(`　${note||'基本'}＝${res.base}`,'act');
  c.innerHTML=`<div class="cl">${note||'基本'}<em>${fmt(res.base)}</em></div>`;
  bs.textContent=fmt(res.base);retrigger(bs,'pulse');
  await sleep(res.steps.length?240:120);
  for(const s of res.steps){
    p.hot=s.id;render();
    rec(`　${s.name}${s.msg?'（'+s.msg+'）':''} ${s.t} → ${s.v}`,'act');
    c.innerHTML+=`<div class="cl"><b>${s.name}</b> ${s.msg||''} ${s.t}<em>→ ${fmt(s.v)}</em></div>`;
    bs.textContent=fmt(s.v);retrigger(bs,'pulse');
    await sleep(260);
  }
  p.hot=null;render();
  rec(`　▶ 最終値 ${fmt(res.final)}`,'act');
  await sleep(res.steps.length?220:80);
  bs.textContent='';c.innerHTML='';
}
async function turnStartItems(){
  const P=pool();
  for(const it of equipped()){
    if(!it.turn)continue;
    const r=it.turn(P);if(!r)continue;
    p.hot=it.id;
    if(r.shield){const sh=R(r.shield*equipped().reduce((m,x)=>m*(x.shieldMul||1),1));p.shield+=sh;log(`${it.name}：${r.msg} → シールド+${sh}`);popup('pl','+'+sh,'heal')}
    if(r.heal){log(`${it.name}：${r.msg} → HP+${r.heal}`);healP(r.heal)}
    if(r.mp){p.mp=Math.min(p.maxMp,p.mp+r.mp);log(`${it.name}：${r.msg} → MP+${r.mp}`)}
    render();await sleep(320);
    p.hot=null;
  }
  render();
}
function slotRows(){
  return p.equip.map((x,i)=>({nm:`${i+1}. ${SLOT_NAME[x.t]}`,it:x.id?ITEM_BY[x.id]:null,x,i}));
}
const mvBtns=(i,mode)=>`<span class="mv"><button class="mvb" ${mode==='shop'?`data-i="mv:${i}:up"`:`data-mv="${i}:up"`} ${i===0?'disabled':''} aria-label="上へ">▲</button><button class="mvb" ${mode==='shop'?`data-i="mv:${i}:down"`:`data-mv="${i}:down"`} ${i===p.equip.length-1?'disabled':''} aria-label="下へ">▼</button></span>`;
function equipHTML(){
  const tot={weapon:0,armor:0,acc:0};p.equip.forEach(x=>{tot[x.t]++});
  return `<div class="eqh">装備（上から順に発動。▲▼で並び替え）　枠：武器${tot.weapon}／防具${tot.armor}／アクセ${tot.acc}</div>`+slotRows().map(r=>
    `<div class="eq ${r.it&&p.hot===r.it.id?'hot':''} ${r.it&&r.it.leg?'leg':''}"><span class="es">${r.nm}</span>${r.it?`<b>${r.it.name}</b>`:`<b class="none">（空き）</b>`}${mvBtns(r.i,'play')}${r.it?`<span class="ed">${r.it.desc}</span>`:''}</div>`).join('');
}
async function equipItem(it,paid){
  const mine=p.equip.filter(x=>x.t===it.slot);
  let slot=mine.find(x=>!x.id);
  const half=Math.round(it.price/2);
  if(!slot){
    const opts=mine.map((x,i)=>{const old=ITEM_BY[x.id];return {x,name:`${old.name}と入れ替える`,tag:SLOT_NAME[it.slot]+(mine.length>1?(i+1):''),desc:`${old.desc}（外した装備は${Math.round(old.price/2)}Gで売却）`,cls:old.leg?'legend':''}});
    opts.push({x:null,name:'見送る',tag:'',desc:paid?`${it.name}は買わない（代金は戻る）`:`${it.name}は受け取らない（${half}Gになる）`});
    const o=await pick(`${it.name}を装備する？`,`${it.desc}`,opts);
    if(!o.x){if(!paid){p.gold+=half;log(`${it.name}を見送り、${half}Gを得た。`)}return false}
    p.gold+=Math.round(ITEM_BY[o.x.id].price/2);
    slot=o.x;
  }
  slot.id=it.id;log(`${it.name}を装備した！`);
  return true;
}

/* ===== 攻撃時の状態異常 =====
   装備シートの「攻撃時の状態異常」に 毒・火傷・出血・スタン・凍結・弱体・弱点看破 のどれかを書くと、
   その装備を付けているあいだ、攻撃でダメージを与えるたびに敵へ付与する（プログラムの追加は不要）。
   毒・火傷・出血の強さ ＝ 与えたダメージ × 「状態異常の強さ」を、3ターンのあいだ毎ターン与える。
   付与確率が空なら100%。 */
const STATUS_LABEL={poison:'毒',burn:'火傷',bleed:'出血',stun:'スタン',freeze:'凍結',weaken:'弱体',vulnerable:'弱点看破'};
const STATUS_DOT={poison:1,burn:1,bleed:1};
function itemStatusOnHit(dealt,P){
  if(!(dealt>0)||!e||e.hp<=0)return;
  const rs={};
  for(const it of equipped()){
    const k=it.statusOnHit;if(!k)continue;
    const chance=Math.min(1,(it.statusChance===undefined?1:it.statusChance)+(it.statusChance===undefined?0:roleChanceBonus(P||pool())));   // 技巧（5）の目で付与確率アップ
    if(!(Math.random()<chance))continue;
    if(k==='poison'){const pow=it.statusPower===undefined?0.005:it.statusPower;rs.poison=Math.max(rs.poison||0,pow)}   // 毒だけ：敵の最大HPに対する割合（0.01＝1%）
    else if(STATUS_DOT[k]){const pow=it.statusPower===undefined?0.15:it.statusPower;rs[k]=Math.max(rs[k]||0,pow)}   // 火傷・出血：与えたダメージに対する割合
    else rs[k]=true;
    rec(`　${it.name}：攻撃時に${STATUS_LABEL[k]}`,'act');
  }
  if(Object.keys(rs).length)applyStatuses(rs,true,P,dealt);
