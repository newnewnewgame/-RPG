async function hit(amount){
  let d=Math.max(1,R(cl(amount)));
  if(e.vulnerable){const vm=e.vulnMul||1.5;d=R(d*vm);e.vulnerable=false;log(`${e.name}の隙を突いた！ダメージ${fmtM(+vm.toFixed(2))}倍！`)}
  const big=d>=e.maxHp*.25;
  e.hp=Math.max(0,e.hp-d);
  if(d>(p.maxHit||0)){p.maxHit=d}
  log(`${e.name}に${fmt(d)}のダメージ！`);popup('scene',fmt(d),big?'dmg big':'dmg');shake(big);render();
  await sleep(big?520:380);
  return d;
}
function healP(n){
  const before=p.hp;p.hp=Math.min(p.maxHp,p.hp+n);
  const g=p.hp-before;log(`HPが${g}回復した。`);popup('pl','+'+g,'heal');render();
}
// 敵に状態異常を付ける（スキルの結果 r と、装備の「攻撃時の状態異常」の両方から使う）。keep=true なら、すでにある毒・火傷・出血より弱くならない
// 状態異常を付ける。火傷・出血の強さは「base（その行動が与えたダメージ）× r.burn / r.bleed（割合）」。毒は「敵の最大HP × r.poison（割合）」
function applyStatuses(r,keep,P,base){
  const P2=P||pool(),sm=roleStatusMul(P2),dur=roleStatusDuration(P2),wm=roleWeakMul(P2),vm=roleVulnMul(P2);   // 技巧（5）の目：状態異常が強くなり、毒・火傷・出血は長く続く
  // 毒：敵の最大HPの％を、毎ターン。重ねがけで割合が増える（上限 CFG.poisonCap）。長引く戦い（ボス）向け
  if(r.poison){
    const pmul=equipped().reduce((m,it)=>m*(it.poisonMul||1),1),cur=e.poison;
    e.poison={t:Math.max(3+dur,cur?cur.t:0),pct:Math.min(CFG.poisonCap,(cur?cur.pct:0)+r.poison*pmul*sm)};
    log(`${e.name}は毒に侵された！（毎ターン最大HPの${fmtM(+(e.poison.pct*100).toFixed(1))}%）`);codexStatus('poison');render();
  }
  // 火傷：付与した瞬間に1回分のダメージが入り、そのあと2ターン続く（武器の連続付与では、火傷が付いていないときだけ即時ダメージ）
  if(r.burn){
    const d=Math.max(1,R((base||0)*r.burn*sm)),cur=e.burn;
    e.burn={t:2+dur,d:keep&&cur?Math.max(cur.d,d):d};
    if(!keep||!cur){e.hp=Math.max(0,e.hp-d);log(`${e.name}は火傷した！即座に${fmt(d)}のダメージ！`,true);popup('scene',d,'dmg');rec(`　火傷：即時ダメージ${fmt(d)}`,'act')}
    else log(`${e.name}の火傷が続く。`);
    codexStatus('burn');render();
  }
  // 出血：敵がダメージを受けるたびに、追加ダメージ（時間では減らない）
  if(r.bleed){
    const d=Math.max(1,R((base||0)*r.bleed*sm)),cur=e.bleed;
    e.bleed={t:3+dur,d:keep&&cur?Math.max(cur.d,d):d};
    log(`${e.name}は出血した！（ダメージを受けるたびに${fmt(d)}）`);codexStatus('bleed');render();
  }
  if(r.stun){if(e.boss){e.weak=true;e.weakMul=wm;codexStatus('weak');log('ボスにはスタンが効かない！次の攻撃を弱体化！')}else{e.stun=1;codexStatus('stun');log(`${e.name}はスタンした！`)}render()}
  if(r.vulnerable){e.vulnerable=true;e.vulnMul=vm;log(`${e.name}の防御の隙を作った！次の攻撃の被ダメージ${fmtM(+vm.toFixed(2))}倍！`);codexStatus('vulnerable');render()}
  if(r.weaken){e.weak=true;e.weakMul=wm;log(`${e.name}の次の攻撃が弱まった！`);codexStatus('weak');render()}
  if(r.freeze){
    if(e.boss){e.weak=true;e.weakMul=wm;codexStatus('weak');log(`${e.name}の次の攻撃が弱まった！`)}
    else if(!e.frozenUsed){e.frozen=true;e.frozenUsed=true;codexStatus('freeze');log(`${e.name}は凍りついた！`)}
    else log(`${e.name}はもう凍らない！`);
    render();
  }
}
// 出血：敵がダメージを受けるたびに、追加ダメージ（付与した行動そのもののダメージでは発動しない）
async function bleedTrigger(){
  const st=e.bleed;if(!st||e.hp<=0)return;
  const d=st.d;e.hp=Math.max(0,e.hp-d);st.t--;if(st.t<=0)e.bleed=null;
  rec(`【出血】${e.name}に出血ダメージ${fmt(d)}`,'take');log(`出血で${e.name}に${fmt(d)}のダメージ！`,true);popup('scene',d,'dmg');render();await sleep(220);
}
async function apply(r,P){
  if(r.gold){p.gold+=r.gold;log(`ゴールドレイン：${fmt(r.gold)}Gを得た！`);popup('pl','+'+fmt(r.gold)+'G','gold');render();}
  if(r.hpCost){p.hp=Math.max(1,p.hp-r.hpCost);log(`HPを${r.hpCost}支払った。`);popup('pl','-'+r.hpCost,'hurt');render();await sleep(250)}
  if(r.dbl){p.dbl=true;log('次のダメージが2倍になる！');render();await sleep(300)}
  let dealt=0;
  if(r.dmg){const res=runPipeline(r.dmg,P,false,ALL[p.currentSkill]);await cascade(res,r.note);let fin=res.final;const cc=roleCritChance(P);if(cc>0&&Math.random()<cc){fin=Math.max(1,R(fin*roleCritMul()));log('💥会心！',true);rec(`　会心！ダメージ×${fmtM(roleCritMul())}`,'act');popup('scene','会心！','dmg')}   // 会心（3）の目
    const d=await hit(fin);dealt=d;p.dbl=false;p.bank=0;if(equipped().some(it=>it.id==='chainorb'))p.chain=(p.chain||0)+1;if(r.drain&&d>0)healP(d);for(const it of equipped()){if(it.hit){const h=it.hit(d);if(h&&h.heal){p.hot=it.id;healP(h.heal)}}}p.hot=null}
  if(dealt>0&&e.bleed&&e.hp>0)await bleedTrigger();
  if(e.hp<=0)return;
  applyStatuses(r,false,P,dealt);
  if(dealt>0)itemStatusOnHit(dealt,P);
  if(r.heal){healP(r.heal);await sleep(300)}
  if(r.shield){
    let sh=r.shield;
    if(r.isGuard){const g=guardFinal(r.shield,P);if(g.steps.length)await cascade(g,r.note);sh=g.final}
    p.shield+=sh;log(`シールドを${sh}張った。`);render();await sleep(300);
  }
  if(r.barrier){p.barrier+=r.barrier;log(`バリアを${r.barrier}張った。`);render();await sleep(300)}
}
