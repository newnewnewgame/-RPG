function labelOf(r,P,sk){
  const t=[];
  if(r.dmg)t.push(`ダメージ約${fmt(previewFinal(r.dmg,P,sk))}`);
  if(r.poison)t.push(`毒${fmtM(+(r.poison*100).toFixed(1))}%/ターン`);
  if(r.burn&&r.dmg)t.push(`火傷約${fmt(R(previewFinal(r.dmg,P,sk)*r.burn))}`);
  if(r.bleed&&r.dmg)t.push(`出血約${fmt(R(previewFinal(r.dmg,P,sk)*r.bleed))}×3回`);
  if(r.freeze)t.push(e.boss?'攻撃半減':'凍結');
  if(r.drain)t.push('吸収');
  if(r.heal)t.push(`HP+${fmt(r.heal)}`);
  if(r.shield)t.push(`シールド${fmt(r.isGuard?guardFinal(r.shield,P).final:r.shield)}`);
  if(r.barrier)t.push(`バリア${fmt(r.barrier)}`);
  if(r.hpCost)t.push(`HP-${r.hpCost}`);
  if(r.dbl)t.push('次のダメージ×2');
  if(r.dmg&&roleCritChance(P)>0)t.push(`会心${Math.round(roleCritChance(P)*100)}%`);
  t.push(`速さ${actionSpeed(P)}`);
  return t.join('・');
}

